# Copie este archivo como .env (o ejecute ./generar_env.sh) y cambie todos los valores.
# El archivo .env nunca se sube al repositorio. En Azure estos valores viven en Key Vault.
POSTGRES_PASSWORD=cambiar
CDSS_DB_PWD_CLINICA=cambiar
CDSS_DB_PWD_GENERACION=cambiar
CDSS_DB_PWD_ADMIN=cambiar
CDSS_DB_PWD_AUDITOR=cambiar
CDSS_DB_PWD_INDEXADOR=cambiar
JWT_SECRETO=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres
CDSS_CLAVE_PII=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres
CDSS_CLAVE_HMAC=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres
# Contraseña de los usuarios de prueba que crea seed_demo (solo desarrollo)
SEED_CONTRASENA=Cdss2026!
# Sprint 2: claves de los proveedores del modelo de lenguaje
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Parte D1 (opcionales): consultas simultáneas al servicio modelos (vacío = automático,
# núcleos / hilos de modelos) y a la API; CALENTAR_LLM=true agrega una llamada sintética
# a la API en el calentamiento al arrancar
# MAX_CONCURRENCIA_RERANKER=
# MAX_CONCURRENCIA_LLM=4
# CALENTAR_LLM=false
