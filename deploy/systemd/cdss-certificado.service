# Sprint 3, parte L. Se instala con: sudo cp deploy/systemd/cdss-certificado.* /etc/systemd/system/
# (docs/despliegue_azure.md). Supone el repositorio en /opt/cdss-anemia.
[Unit]
Description=Renovación del certificado de Let's Encrypt del CDSS (deploy/renovar_certificado.sh)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/cdss-anemia
ExecStart=/bin/bash /opt/cdss-anemia/deploy/renovar_certificado.sh renovar
TimeoutStartSec=1h
