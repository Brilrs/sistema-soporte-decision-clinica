# Nginx en Azure (parte L del Sprint 3). Plantilla: al arrancar, la imagen oficial de nginx reemplaza
# ${CDSS_DOMINIO} (solo las variables que empiezan con CDSS_, NGINX_ENVSUBST_FILTER) y escribe
# /etc/nginx/conf.d/default.conf. docker-compose.prod.yml la activa con NGINX_ENVSUBST_TEMPLATE_DIR;
# en desarrollo no se usa (nginx.conf, puerto 80).
#
# El certificado de Let's Encrypt vive en el volumen certbot_certificados y el desafío HTTP-01 en
# certbot_webroot (deploy/renovar_certificado.sh y docs/despliegue_azure.md).

# Nivel http (la imagen incluye conf.d/default.conf dentro de http). El nombre que da Azure
# (<etiqueta>.chilecentral.cloudapp.azure.com, 48 caracteres) no cabe en el cubo por omisión de 64
# bytes: Nginx no arranca («could not build server_names_hash»).
server_names_hash_bucket_size 128;

# HTTP (80): solo el desafío de Let's Encrypt y la redirección a HTTPS.
server {
    listen 80;
    server_name ${CDSS_DOMINIO};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Cualquier otro nombre o la IP directa: se cierra la conexión sin responder.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# HTTPS (443): la aplicación, con TLS 1.2 o superior.
server {
    listen 443 ssl;
    http2 on;
    server_name ${CDSS_DOMINIO};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${CDSS_DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CDSS_DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/cdss/rutas.conf;
}
